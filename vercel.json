{
  "version": 2,
  "routes": [
    {
      "src": "/landing/(.*)",
      "dest": "/frontend/landing/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/frontend/auth/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}